# Copy to .env and fill in. Never commit .env.
# App role password is set out-of-band by the server admin:
#   ALTER ROLE personal_tracking_app PASSWORD '<secret>';
DATABASE_URL=postgresql://personal_tracking_app:<password>@jsl6906.postgres.database.azure.com:5432/personal_storage?sslmode=require

# Optional overrides
# DB_SCHEMA=personal_tracking
# DB_POOL_MIN=1
# DB_POOL_MAX=4
# APP_TZ=America/New_York
# LOG_FILE=app.log
# RELOAD=0

# Optional: Jellyfin movie suggestions for the Movie Night spinner.
# Create the key in Jellyfin Dashboard -> API Keys; setting it enables the integration.
# JELLYFIN_URL defaults to http://jellyfin:8096 (compose service on MediaServer); set it when running locally.
# JELLYFIN_URL=http://mediaserver:8096
# JELLYFIN_API_KEY=<api key>
# JELLYFIN_CACHE_TTL=900
# JELLYFIN_RECENT_DAYS=365
