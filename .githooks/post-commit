#!/bin/sh
# Wrapper to invoke the PowerShell post-commit hook.
# Adds diagnostics and a lightweight fallback build if PowerShell execution fails.
# Git requires the hook filename to be exactly 'post-commit' (no extension).
# This wrapper calls the existing PowerShell script so we keep logic in one place.

LOG_FILE="dist/.post-commit.log"
mkdir -p dist 2>/dev/null || true
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] wrapper start" >> "$LOG_FILE"

HOOK_DIR="$(dirname "$0")"
PS_SCRIPT="$HOOK_DIR/post-commit.ps1"

if [ ! -f "$PS_SCRIPT" ]; then
  echo "[post-commit wrapper] Missing PowerShell script: $PS_SCRIPT" | tee -a "$LOG_FILE" >&2
  exit 0
fi

# Prefer pwsh (PowerShell 7+), fall back to Windows PowerShell if available under 'powershell'
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$PS_SCRIPT" 2>&1 | tee -a "$LOG_FILE"
  status=${PIPESTATUS[0]}
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$PS_SCRIPT" 2>&1 | tee -a "$LOG_FILE"
  status=${PIPESTATUS[0]}
else
  echo "[post-commit wrapper] No PowerShell host (pwsh or powershell) found in PATH; skipping image build." | tee -a "$LOG_FILE" >&2
  status=0
fi

if [ "$status" -ne 0 ]; then
  echo "[post-commit wrapper] PowerShell hook failed (exit $status). Attempting minimal docker fallback." | tee -a "$LOG_FILE"
  if command -v docker >/dev/null 2>&1; then
    short_sha=$(git rev-parse --short HEAD 2>/dev/null)
    tag="${short_sha:-unknown}"
    echo "[post-commit wrapper] Fallback building image personal-tracking:$tag" | tee -a "$LOG_FILE"
    if docker build -t personal-tracking:$tag . >> "$LOG_FILE" 2>&1; then
      out_tar="dist/personal-tracking-${tag}.tar"
      if docker save -o "$out_tar" personal-tracking:$tag >> "$LOG_FILE" 2>&1; then
        echo "[post-commit wrapper] Fallback tar created: $out_tar" | tee -a "$LOG_FILE"
      else
        echo "[post-commit wrapper] Fallback docker save failed" | tee -a "$LOG_FILE"
      fi
    else
      echo "[post-commit wrapper] Fallback docker build failed" | tee -a "$LOG_FILE"
    fi
  else
    echo "[post-commit wrapper] Docker not available for fallback." | tee -a "$LOG_FILE"
  fi
fi

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] wrapper end status=$status" >> "$LOG_FILE"
exit 0
